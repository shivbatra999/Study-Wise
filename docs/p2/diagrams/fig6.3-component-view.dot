digraph components {
  rankdir=TB; newrank=true; fontname="Helvetica"; nodesep=0.5; ranksep=0.55;
  node [shape=component, style=filled, fillcolor="#eef3fb", fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#333333"];
  student [shape=none, fillcolor=none, label="Student\n(actor)", fontsize=12];
  subgraph cluster_sw {
    label="Study-Wise (system boundary)"; style="rounded"; color="#1f4e8c"; fontcolor="#1f4e8c"; fontsize=13;
    subgraph cluster_pres { label="Presentation layer"; style=dashed; color="#888888"; fontcolor="#555555"; StudyUI; }
    subgraph cluster_api  { label="API layer"; style=dashed; color="#888888"; fontcolor="#555555"; LocalApi; }
    subgraph cluster_app  { label="Application layer"; style=dashed; color="#888888"; fontcolor="#555555"; MaterialIngestor; AnswerService; QuizService; }
    subgraph cluster_dom  { label="Domain layer"; style=dashed; color="#888888"; fontcolor="#555555"; CourseLibrary; PassageIndex; }
    subgraph cluster_inf  { label="Data and integration layer"; style=dashed; color="#888888"; fontcolor="#555555"; LocalStore; RuntimeGateway; }
  }
  fs  [shape=box3d, fillcolor="#f2f2f2", label="<<external system>>\nStudent's local file system"];
  llm [shape=box3d, fillcolor="#f2f2f2", label="<<external system>>\nLocal LLM runtime"];
  student -> StudyUI [label="uses"];
  StudyUI -> LocalApi [label="StudyRequests"];
  LocalApi -> MaterialIngestor [label="ImportMaterials"];
  LocalApi -> AnswerService [label="AskQuestion"];
  LocalApi -> QuizService [label="PracticeQuiz"];
  LocalApi -> CourseLibrary [label="ManageLibrary"];
  MaterialIngestor -> CourseLibrary [label="RecordMaterial"];
  MaterialIngestor -> PassageIndex [label="AddPassages"];
  AnswerService -> PassageIndex [label="FindPassages"];
  QuizService -> PassageIndex [label="FindPassages"];
  AnswerService -> RuntimeGateway [label="Generate"];
  QuizService -> RuntimeGateway [label="Generate"];
  PassageIndex -> RuntimeGateway [label="Embed"];
  CourseLibrary -> LocalStore [label="Persist"];
  PassageIndex -> LocalStore [label="Persist"];
  LocalApi -> RuntimeGateway [label="RuntimeStatus", style=dashed];
  MaterialIngestor -> fs [label="reads chosen files\n(read only)"];
  RuntimeGateway -> llm [label="local runtime API"];
  {rank=same; LocalStore; RuntimeGateway; fs; llm}
}
